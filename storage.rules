rules_version = '2';

// Firebase Storage Security Rules for Daggerheart Campaign Manager
service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get campaign data from Firestore
    function getCampaign(campaignId) {
      return firestore.get(/databases/(default)/documents/campaigns/$(campaignId)).data;
    }

    // Helper function to check if user is a member of the campaign
    function isCampaignMember(campaignId) {
      let campaign = getCampaign(campaignId);
      return campaign.members[request.auth.uid] != null;
    }

    // Helper function to check if user is a DM of the campaign
    function isCampaignDM(campaignId) {
      let campaign = getCampaign(campaignId);
      return campaign.dmId == request.auth.uid;
    }

    // True when the campaign has flipped on a public read-only chronicle.
    // Used to allow unauthenticated reads of storybook images via a share link.
    function isChroniclePublic(campaignId) {
      return getCampaign(campaignId).get('chroniclePublic', false) == true;
    }

    // Campaign files rules
    match /campaigns/{campaignId}/files/{fileName} {
      // Allow read if user is a member of the campaign
      allow read: if isAuthenticated() && isCampaignMember(campaignId);

      // Allow write (upload) if user is a DM of the campaign
      allow create: if isAuthenticated() && isCampaignDM(campaignId)
                    && request.resource.size < 50 * 1024 * 1024; // Max 50MB

      // Allow delete if user is a DM of the campaign
      allow delete: if isAuthenticated() && isCampaignDM(campaignId);
    }

    // Campaign map images rules
    match /campaigns/{campaignId}/maps/{fileName} {
      // Allow read if user is a member of the campaign
      allow read: if isAuthenticated() && isCampaignMember(campaignId);

      // Allow write (upload) if user is a member (maps can be generated by anyone)
      allow create: if isAuthenticated() && isCampaignMember(campaignId)
                    && request.resource.size < 10 * 1024 * 1024; // Max 10MB

      // Allow delete if user is a DM of the campaign
      allow delete: if isAuthenticated() && isCampaignDM(campaignId);
    }

    // Player Display images and videos (quick uploads for TV display)
    match /campaigns/{campaignId}/display/{fileName} {
      // Allow read if user is a member of the campaign
      allow read: if isAuthenticated() && isCampaignMember(campaignId);

      // Allow write (upload) if user is a DM of the campaign
      // 500MB cap supports videos; ContentSelector.jsx enforces stricter image limits client-side
      allow create: if isAuthenticated() && isCampaignDM(campaignId)
                    && request.resource.size < 500 * 1024 * 1024; // Max 500MB for video

      // Allow delete if user is a DM of the campaign
      allow delete: if isAuthenticated() && isCampaignDM(campaignId);
    }

    // NPC Portrait images (AI-generated portraits)
    match /campaigns/{campaignId}/portraits/{fileName} {
      // Allow read if user is a member of the campaign
      allow read: if isAuthenticated() && isCampaignMember(campaignId);

      // Allow write (upload) if user is a member (portraits can be generated by anyone)
      allow create: if isAuthenticated() && isCampaignMember(campaignId)
                    && request.resource.size < 10 * 1024 * 1024; // Max 10MB

      // Allow delete if user is a DM of the campaign
      allow delete: if isAuthenticated() && isCampaignDM(campaignId);
    }

    // Lore entry images (AI-generated lore visuals)
    match /campaigns/{campaignId}/lore/{fileName} {
      // Allow read if user is a member of the campaign
      allow read: if isAuthenticated() && isCampaignMember(campaignId);

      // Allow write (upload) if user is a DM of the campaign
      allow create: if isAuthenticated() && isCampaignDM(campaignId)
                    && request.resource.size < 10 * 1024 * 1024; // Max 10MB

      // Allow delete if user is a DM of the campaign
      allow delete: if isAuthenticated() && isCampaignDM(campaignId);
    }

    // AI-generated audio files (sound effects and music)
    match /campaigns/{campaignId}/audio/{fileName} {
      // Allow read if user is a member of the campaign
      allow read: if isAuthenticated() && isCampaignMember(campaignId);

      // Allow write (upload) if user is a member of the campaign
      allow create: if isAuthenticated() && isCampaignMember(campaignId)
                    && request.resource.size < 5 * 1024 * 1024; // Max 5MB

      // Allow delete if user is a DM of the campaign
      allow delete: if isAuthenticated() && isCampaignDM(campaignId);
    }

    // Battle Map Studio images (AI-generated battle maps and assets)
    match /campaigns/{campaignId}/battleMaps/{fileName} {
      // Allow read if user is a member of the campaign
      allow read: if isAuthenticated() && isCampaignMember(campaignId);

      // Allow write (upload) if user is a DM of the campaign
      allow create: if isAuthenticated() && isCampaignDM(campaignId)
                    && request.resource.size < 20 * 1024 * 1024; // Max 20MB for high-res maps

      // Allow delete if user is a DM of the campaign
      allow delete: if isAuthenticated() && isCampaignDM(campaignId);
    }

    // Storybook illustrations (AI-generated scenes, 10MB cap)
    match /campaigns/{campaignId}/storybook/images/{fileName} {
      allow read: if (isAuthenticated() && isCampaignMember(campaignId)) || isChroniclePublic(campaignId);
      allow create: if isAuthenticated() && isCampaignMember(campaignId)
                    && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isAuthenticated() && isCampaignDM(campaignId);
    }

    // Storybook styled portraits (per-entity cached, 10MB cap)
    match /campaigns/{campaignId}/storybook/styled-portraits/{fileName} {
      allow read: if (isAuthenticated() && isCampaignMember(campaignId)) || isChroniclePublic(campaignId);
      allow create: if isAuthenticated() && isCampaignMember(campaignId)
                    && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isAuthenticated() && isCampaignDM(campaignId);
    }

    // Storybook user-uploaded media (images/video/audio, 500MB cap for video)
    match /campaigns/{campaignId}/storybook/media/{fileName} {
      allow read: if (isAuthenticated() && isCampaignMember(campaignId)) || isChroniclePublic(campaignId);
      allow create: if isAuthenticated() && isCampaignMember(campaignId)
                    && request.resource.size < 500 * 1024 * 1024;
      allow delete: if isAuthenticated() && (isCampaignDM(campaignId) || isCampaignMember(campaignId));
    }

    // Shared Assets (cross-campaign asset library)
    match /sharedAssets/{path=**} {
      // Allow read by any authenticated user
      allow read: if isAuthenticated();

      // Allow write (upload) by any authenticated user
      allow create: if isAuthenticated()
                    && request.resource.size < 5 * 1024 * 1024; // Max 5MB per asset

      // Deny delete (only admins can clean up via console)
      allow delete: if false;
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
