{
  "name": "daggerheart-campaign-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "esbuild scripts/smoke.test.jsx --bundle --platform=node --jsx=automatic --loader:.js=jsx --loader:.css=empty --outfile=node_modules/.cache/smoke.test.cjs --log-level=error && node node_modules/.cache/smoke.test.cjs",
    "sheet:template": "node scripts/extract-sheet-template.mjs",
    "sheet:preview": "esbuild scripts/render-sheet-preview.mjs --bundle --platform=node --format=esm --loader:.js=jsx --loader:.css=empty --outfile=node_modules/.cache/sheet-preview.mjs --log-level=error && node node_modules/.cache/sheet-preview.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.1.4",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@sparticuz/chromium": "^143.0.4",
    "busboy": "^1.6.0",
    "dotenv": "^17.2.3",
    "firebase": "^12.6.0",
    "konva": "^10.2.0",
    "lucide-react": "^0.468.0",
    "openai": "^6.16.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.59.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.14",
    "react-markdown": "^10.1.0",
    "three": "^0.182.0",
    "use-image": "^1.1.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.24",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^6.0.3"
  }
}
